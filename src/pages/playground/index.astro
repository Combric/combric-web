---
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";
import { Playground } from "../../playground/Playground";
import { siteUrl } from "../../lib/siteOrigin";
import { socialHead } from "../../lib/seo";
---

<StarlightPage
  frontmatter={{
    title: "Playground",
    description: "Controlled real-component preview and code generator.",
    tableOfContents: false,
  }}
>
  <Fragment slot="head">
    <link rel="canonical" href={siteUrl("/playground/")} />
    {socialHead(
      "Playground — Combric",
      "Controlled real-component preview and code generator.",
      "/playground/",
    ).map((tag) => (
      <meta {...tag} />
    ))}
  </Fragment>
  <p>
    Explore approved props and states from the real public component package.
    This Playground never evaluates user code, installs dependencies, edits
    tokens, or persists projects.
  </p>
  <Playground client:load />
</StarlightPage>
