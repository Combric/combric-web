---
import {
  catalogue,
  catalogueApiForVersion,
  catalogueRoute,
  sourceUrl,
} from "../data/catalogue";
import { documentationVersions } from "../data/versions";
import { catalogueDemosFor } from "../examples/catalogue-examples";
import CatalogueDemo from "./CatalogueDemo.astro";

type Section =
  | "intro"
  | "usage"
  | "examples"
  | "api"
  | "accessibility"
  | "keyboard"
  | "customization"
  | "source";

interface Props {
  slug: string;
  section: Section;
}

const { slug, section } = Astro.props;
const item = catalogue.find((candidate) => candidate.slug === slug);
if (!item) throw new Error(`Unknown catalogue slug: ${slug}`);
const version = Astro.url.pathname.match(/^\/docs\/(v\d+\.\d+\.\d+)\//)?.[1];
if (!version)
  throw new Error(
    `Catalogue page is not under a versioned route: ${Astro.url.pathname}`,
  );
const documentationVersion = documentationVersions.find(
  (candidate) => candidate.id === version,
);
if (!documentationVersion)
  throw new Error(`Unknown documentation version: ${version}`);
const demos = catalogueDemosFor(version, slug);
if (!demos.length) throw new Error(`Missing examples for ${version}/${slug}`);
const importCode = `import { ${item.publicExports.join(", ")} } from "${item.package}";`;
const apiContracts = catalogueApiForVersion(item, version).map((contract) => {
  const separator = contract.indexOf(":");
  return separator < 0
    ? { name: "Contract", details: contract }
    : {
        name: contract.slice(0, separator),
        details: contract.slice(separator + 1).trim(),
      };
});
---

{section === "intro" && (
  <>
    <p class="combric-docs-summary">{item.summary}</p>
    <p class="combric-docs-version">
      <a href={catalogueRoute(documentationVersion, item)}>
        {item.package} · {documentationVersion.label} ·{" "}
        {documentationVersion.status === "current" ? "Current" : "Previous"}
      </a>
    </p>
  </>
)}

{section === "usage" && (
  <>
    <pre
      class="combric-docs-import"
      tabindex="0"
    ><code>{importCode}</code></pre>
    <p>
      Load the native stylesheet with <code>@import "@combric/react/css";</code>
      . This path does not require Tailwind.
    </p>
  </>
)}

{section === "examples" && (
  <>
    {demos.map((demo) => (
      <CatalogueDemo demo={demo} />
    ))}
  </>
)}

{section === "api" && (
  <>
    <div class="combric-docs-api">
      <table>
        <caption>Public exports</caption>
        <thead>
          <tr>
            <th scope="col">Name</th>
          </tr>
        </thead>
        <tbody>
          {item.publicExports.map((name) => (
            <tr>
              <td>
                <code>{name}</code>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
      <table class="combric-docs-api-contracts">
        <caption>Documented contracts</caption>
        <thead>
          <tr>
            <th scope="col">Property / capability</th>
            <th scope="col">Published contract</th>
          </tr>
        </thead>
        <tbody>
          {apiContracts.map(({ name, details }) => (
            <tr>
              <th scope="row">{name}</th>
              <td>{details}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    {item.aliases && (
      <div class="combric-docs-aliases">
        <table>
          <caption>Exact aliases</caption>
          <thead>
            <tr>
              <th scope="col">Alias</th>
              <th scope="col">Canonical export</th>
            </tr>
          </thead>
          <tbody>
            {Object.entries(item.aliases).map(([alias, canonical]) => (
              <tr>
                <td>
                  <code>{alias}</code>
                </td>
                <td>
                  <code>{canonical}</code>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    )}
  </>
)}

{section === "accessibility" && <p>{item.accessibility}</p>}

{section === "keyboard" && item.keyboard && <p>{item.keyboard}</p>}

{section === "customization" && (
  <p>
    Combric classes and canonical <code>--combric-*</code> variables provide the
    package presentation. Consumer <code>className</code> extends the required
    class; it does not replace the component contract.
  </p>
)}

{section === "source" && (
  <p>
    <a href={sourceUrl(item.source)}>View source on GitHub</a>
  </p>
)}
