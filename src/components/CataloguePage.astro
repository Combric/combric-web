---
import { catalogue, catalogueRoute, sourceUrl } from "../data/catalogue";
import { currentDocumentationVersion } from "../data/versions";
import { catalogueDemosFor } from "../examples/catalogue-examples";
import { ExampleRenderer } from "../examples/ExampleRenderer";
import { CopyButton } from "./CopyButton";

interface Props {
  slug: string;
}
const { slug } = Astro.props;
const item = catalogue.find((candidate) => candidate.slug === slug);
if (!item) throw new Error(`Unknown catalogue slug: ${slug}`);
const version = Astro.url.pathname.match(/^\/docs\/(v\d+\.\d+\.\d+)\//)?.[1];
if (!version)
  throw new Error(
    `Catalogue page is not under a versioned route: ${Astro.url.pathname}`,
  );
const demos = catalogueDemosFor(version, slug);
if (!demos.length) throw new Error(`Missing examples for ${version}/${slug}`);
---

<p class="combric-docs-version">
  Documentation:{" "}
  <a href={catalogueRoute(currentDocumentationVersion, item)}>
    {currentDocumentationVersion.label} — Current
  </a>
</p>

<p class="combric-docs-status">
  <strong>Stable 1.0.0:</strong> this API is documented against the published
  public package.
</p>

<p>{item.summary}</p>

<h2>Package</h2>

<p>
  <code>{item.package}</code> with <code>@import "@combric/react/css";</code>.
  The standard CSS path does not require Tailwind.
</p>

<h2>Examples</h2>

{demos.map((demo) => (
  <section class="combric-docs-demo" data-demo-id={demo.id}>
    <h3>{demo.title}</h3>
    <div class="combric-docs-example">
      <ExampleRenderer demoId={demo.id} client:load />
    </div>
    <details class="combric-docs-code">
      <summary>View Code</summary>
      <pre
        class="combric-docs-source"
        tabindex="0"
      ><code>{demo.source}</code></pre>
    </details>
    <CopyButton text={demo.source} label="Copy Code" client:load />
  </section>
))}

<h2>Public API</h2>

<p>Public exports:</p>
<ul>
  {item.publicExports.map((name) => (
    <li>
      <code>{name}</code>
    </li>
  ))}
</ul>
<ul>
  {item.api.map((contract) => (
    <li>{contract}</li>
  ))}
</ul>

{item.aliases && (
  <>
    <h2>Aliases</h2>
    <ul>
      {Object.entries(item.aliases).map(([alias, canonical]) => (
        <li>
          <code>{alias}</code> is an exact naming alias of{" "}
          <code>{canonical}</code>.
        </li>
      ))}
    </ul>
  </>
)}

<h2>Accessibility</h2>

<p>{item.accessibility}</p>

{item.keyboard && (
  <>
    <h2>Keyboard</h2>
    <p>{item.keyboard}</p>
  </>
)}

<h2>CSS and customization</h2>

<p>
  Combric classes and canonical <code>--combric-*</code> variables provide the
  default Metriq presentation. Consumer <code>className</code> extends the
  required class; it does not replace the component contract.
</p>

<p>
  <a href={sourceUrl(item.source)}>View source on GitHub</a>
</p>
