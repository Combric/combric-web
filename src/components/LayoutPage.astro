---
import { layouts, layoutRoute, sourceUrl } from "../data/catalogue";
import { currentDocumentationVersion } from "../data/versions";
import { layoutDemosFor } from "../examples/catalogue-examples";
import { ExampleRenderer } from "../examples/ExampleRenderer";
import { CopyButton } from "./CopyButton";

interface Props {
  slug: string;
}
const { slug } = Astro.props;
const item = layouts.find((candidate) => candidate.slug === slug);
if (!item) throw new Error(`Unknown layout slug: ${slug}`);
const demos = layoutDemosFor(currentDocumentationVersion.id, slug);
if (!demos.length) throw new Error(`Missing layout example: ${slug}`);
---

<p class="combric-docs-version">
  Documentation:{" "}
  <a href={layoutRoute(currentDocumentationVersion, item)}>
    {currentDocumentationVersion.label} — Current
  </a>
</p>

<p>{item.summary}</p>
<p>
  The framework-independent CSS contract is available from{" "}
  <code>@combric/layout/css</code>; the React wrapper is exported by{" "}
  <code>@combric/react</code>.
</p>

<h2>Example</h2>
{demos.map((demo) => (
  <section class="combric-docs-demo" data-demo-id={demo.id}>
    <h3>{demo.title}</h3>
    <div class="combric-docs-example">
      <ExampleRenderer demoId={demo.id} client:load />
    </div>
    <details class="combric-docs-code">
      <summary>View Code</summary>
      <pre
        class="combric-docs-source"
        tabindex="0"
      ><code>{demo.source}</code></pre>
    </details>
    <CopyButton text={demo.source} label="Copy Code" client:load />
  </section>
))}

<h2>API</h2>
<ul>
  {item.api.map((contract) => (
    <li>{contract}</li>
  ))}
</ul>

<h2>Accessibility</h2>
<p>
  Layout changes presentation only. Choose semantic elements and preserve
  meaningful source order; Combric does not add ARIA, reorder content, or
  measure the viewport.
</p>

<p>
  <a href={sourceUrl(item.source)}>View React wrapper source on GitHub</a>
</p>
