---
import { stylingDemosFor } from "../examples/catalogue-examples";
import CatalogueDemo from "./CatalogueDemo.astro";

interface Props {
  comparisonId: string;
}

const { comparisonId } = Astro.props;
const version = Astro.url.pathname.match(/^\/docs\/(v\d+\.\d+\.\d+)\//)?.[1];
if (!version)
  throw new Error(
    `Styling comparison is not under a versioned route: ${Astro.url.pathname}`,
  );
const demos = stylingDemosFor(version, comparisonId);
const nativeDemo = demos.find((demo) => demo.approach === "native-css");
const tailwindDemo = demos.find((demo) => demo.approach === "tailwind");
if (!nativeDemo || !tailwindDemo)
  throw new Error(`Incomplete styling comparison: ${comparisonId}`);
---

<div class="combric-style-comparison" data-comparison-id={comparisonId}>
  {[nativeDemo, tailwindDemo].map((demo) => (
    <CatalogueDemo demo={demo} />
  ))}
</div>
